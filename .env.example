# Neon: Dashboard -> Connect -> copy the "Pooled connection" string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: same dialog with "Connection pooling" switched OFF. Used by migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
# Comma separated list of frontends allowed to call the API (storefront + admin panel)
CLIENT_ORIGIN="http://localhost:5173,http://localhost:5174"
PORT=5000
# Set to e.g. 800 to slow every response down and see the loading states locally
SIMULATE_LATENCY_MS=0
# Cloudinary dashboard -> "API environment variable"
CLOUDINARY_URL=""
# Set to 1 only when using the local `npx prisma dev` database
# DB_POOL_MAX=1
